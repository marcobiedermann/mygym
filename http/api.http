@baseUrl = https://www.mygym-boutique.de/api

###
# Check In Count
# Example response: ./fixtures/checkinCount.json
GET {{baseUrl}}/checkinCount
Accept: application/json

###
# Clubs
# Example response: ./fixtures/clubs.json
